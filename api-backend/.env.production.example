# Production Environment Configuration
# Copy this to .env.production and fill in real values

PORT=3001
NODE_ENV=production

# API Keys (generate strong random keys)
API_KEYS=your-production-api-key-1,your-production-api-key-2

# Security - MUST be false in production
DISABLE_AUTH=false
DISABLE_RATE_LIMIT=false

# Rate limiting
DAILY_REQUEST_LIMIT=100

# Request timeout (ms)
REQUEST_TIMEOUT_MS=15000

# Download engine settings
DOWNLOADS_DIR=downloads
DOWNLOAD_REQUEST_TIMEOUT_MS=120000

# AnimeAV1 domain
DEFAULT_ANIME_DOMAIN=animeav1.com

# Supabase (required for security logging)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS origins (comma-separated)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
