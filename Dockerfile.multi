# =============================================================================
# Stage 1: Build frontend
# =============================================================================
FROM node:20-alpine AS frontend-builder

ARG VITE_API_URL
ARG VITE_API_KEY
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

WORKDIR /app

# Install ALL deps (devDependencies needed for tsc, vite)
COPY concepts/premium-streaming-app/package*.json ./
RUN NODE_ENV=development npm install --include=dev

COPY concepts/premium-streaming-app/ ./

# Write Vite env vars (fail if any are missing)
RUN printf 'VITE_API_URL=%s\nVITE_API_KEY=%s\nVITE_SUPABASE_URL=%s\nVITE_SUPABASE_ANON_KEY=%s\n' \
  "${VITE_API_URL:-/api/v1}" "${VITE_API_KEY}" "${VITE_SUPABASE_URL}" "${VITE_SUPABASE_ANON_KEY}" > .env && \
    test -n "${VITE_API_KEY}" && \
    test -n "${VITE_SUPABASE_URL}" && \
    test -n "${VITE_SUPABASE_ANON_KEY}"

RUN npm run build

# =============================================================================
# Stage 2: Build api-backend
# =============================================================================
FROM node:20-alpine AS api-builder

WORKDIR /app

RUN apk add --no-cache \
    chromium \
    ca-certificates \
    libx11 \
    libxcomposite \
    libxdamage \
    libxext \
    libxrandr \
    mesa \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY api-backend/package*.json ./
RUN NODE_ENV=development npm install --include=dev

COPY api-backend/ ./

EXPOSE 3001
CMD ["npm", "start"]

# =============================================================================
# Stage 3: Final - nginx serving frontend + node for api-backend
# =============================================================================
FROM nginx:alpine

# Install node, supervisor, and chromium
RUN apk add --no-cache \
    nodejs \
    npm \
    supervisor \
    chromium \
    ca-certificates \
    libx11 \
    libxcomposite \
    libxdamage \
    libxext \
    libxrandr \
    mesa

# Copy frontend build artifacts
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Copy nginx.conf - override the default one in conf.d/
COPY concepts/premium-streaming-app/nginx.conf /etc/nginx/conf.d/default.conf

# Copy api-backend (with node_modules from api-builder)
COPY --from=api-builder /app /app/api-backend

RUN mkdir -p /var/log/supervisor

COPY --from=api-builder /usr/bin/chromium-browser /usr/bin/chromium-browser
COPY --from=api-builder /usr/bin/chromium /usr/bin/chromium

# Copy supervisord config from file
COPY supervisord.conf /etc/supervisor/conf.d/puchflix.conf

EXPOSE 80 3001

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/puchflix.conf"]
